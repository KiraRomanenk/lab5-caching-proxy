              "pm.test(\"Статус 200\", function () {\r\n  pm.response.to.have.status(200);\r\n});\r\npm.test(\"Content-Type image/jpeg\", function () {\r\n  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");\r\n});\r\npm.test(\"Картинка з http.cat\", function () {\r\n  pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"http.cat\");\r\n});\r\npm.collectionVariables.set(\"catSize\", pm.response.size().body);"
            ]
          }
        }
